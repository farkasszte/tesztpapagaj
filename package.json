{
  "name": "tesztpapagaj",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8000",
    "dev:room": "cd workers/room && bun run dev",
    "typecheck:room": "cd workers/room && bun run typecheck",
    "deploy:room": "cd workers/room && bun run deploy",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:file": "playwright test --retries=0",
    "test:e2e:strict": "playwright test --retries=0 --forbid-only",
    "test:e2e:fast": "playwright test scripts/game.e2e.ts scripts/game-devices.e2e.ts scripts/peril-board.e2e.ts scripts/champion-devices.e2e.ts scripts/champion-visuals.e2e.ts scripts/play-from-bank.e2e.ts scripts/flashcard.e2e.ts scripts/review-deck.e2e.ts scripts/mode-race-boss.e2e.ts scripts/select-contrast.e2e.ts scripts/folders.e2e.ts scripts/drive-backup.e2e.ts scripts/results-page.e2e.ts scripts/student-card.e2e.ts scripts/game-traffic.e2e.ts --retries=0",
    "test:e2e:each": "bun run scripts/e2e-each.ts",
    "format": "prettier --write .",
    "test:exports": "bun run scripts/test-exports.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@milkdown/crepe": "^7.21.1",
    "@milkdown/kit": "^7.21.1",
    "@milkdown/react": "^7.21.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "ajv": "^8.17.1",
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "katex": "^0.18.0",
    "lucide-react": "^1.34.0",
    "mathjax-full": "3.2.2",
    "pdf-lib": "^1.17.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.3.0",
    "marked": "^18.0.12",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12",
    "katex": "^0.18.4",
    "vue": "^3.5.45"
  }
